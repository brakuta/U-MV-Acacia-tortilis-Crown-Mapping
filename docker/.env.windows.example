# Windows (PowerShell + Docker Desktop).  Copy this file to docker\.env:
#     copy docker\.env.windows.example docker\.env
# The two paths below are correct if the archive was copied with
# tools\windows\copy_archive.ps1 -Destination D:\A.tortilis_Data_Model.
# Otherwise edit them: use forward slashes, keep the double quotes, no '&'.
DATA_DIR="D:/A.tortilis_Data_Model/Data used to build the model"
WEIGHTS_DIR="D:/A.tortilis_Data_Model/A.tortilis Models/Pretrained weights"
HF_HUB_OFFLINE=0
